{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit",
    "schedule:earlyMondays"
  ],
  "timezone": "Etc/UTC",
  "packageRules": [
    {
      "matchPackageNames": [
        "commons-io:commons-io",
        "com.fasterxml.jackson.dataformat:jackson-dataformat-xml"
      ],
      "enabled": false
    }
  ]
}
